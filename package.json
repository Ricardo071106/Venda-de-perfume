    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
