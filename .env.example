# Banco: Supabase. Pegue em Project Settings > Database > Connection string (URI, modo Session).
# Guia completo com passo a passo está no .env real deste projeto.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./service-account.json
GOOGLE_SPREADSHEET_ID=

# WhatsApp (Baileys) — sem Docker, conecta escaneando um QR code no terminal
# ao rodar "npm run dev". Ver guia completo no .env real deste projeto.
WHATSAPP_GROUP_ID=
WHATSAPP_AUTH_FOLDER=./auth_session

# Números autorizados a lançar vendas por comando no WhatsApp, separados por vírgula.
# Formato: código do país + DDD + número, sem símbolos (ex: 5511999999999)
ADMIN_PHONE_NUMBERS=

# Painel administrativo (site com gráficos + botão "Atualizar agora").
# Protegido por usuário/senha porque fica publicamente acessível no endereço
# que o Render fornece. Troque a senha por uma forte antes de subir.
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASSWORD=troque-por-uma-senha-forte
# PORT: em produção o Render define sozinho; não precisa mexer.
